<%@ Page Title="System administration" Language="C#" MasterPageFile="~/MasterPages/SystemAdmin.Master" AutoEventWireup="true" CodeBehind="Dashboard.aspx.cs" Inherits="MajorProject.Web.Secure.SysAdmin.ConsolePage" %>
<asp:Content ID="Main" ContentPlaceHolderID="MainContent" runat="server">
<div class="sysadmin-heading"><div><span class="sysadmin-kicker">SYSTEM CONTROL</span><h1>System administration</h1><p>Manage access, review authenticated sessions and maintain application settings.</p></div><span class="sysadmin-role">SysAdmin access</span></div>
<asp:Label ID="lblMessage" runat="server" Visible="false" CssClass="tw-feedback" role="status"/>
<div data-ui-tabs="sysadmin">
<nav class="tw-record-tabs" role="tablist" aria-label="System administration sections"><button type="button" class="tw-record-tab" data-ui-tab="users">Users</button><button type="button" class="tw-record-tab" data-ui-tab="create">Register users</button><button type="button" class="tw-record-tab" data-ui-tab="sessions">Sessions</button><button type="button" class="tw-record-tab" data-ui-tab="reports">Reports</button><button type="button" class="tw-record-tab" data-ui-tab="settings">Configuration</button></nav>
<section data-ui-pane="users" class="sysadmin-pane"><div data-record-tabs="sysadmin-users" data-tab-labels="list=Accounts;details=Account profile"><div data-tab-pane="list"><div class="sysadmin-toolbar"><div><label for="<%= txtSearch.ClientID %>">Find an account</label><asp:TextBox ID="txtSearch" runat="server" CssClass="form-control" MaxLength="100" placeholder="Name, username or email prefix"/></div><asp:Button ID="btnSearch" runat="server" Text="Search" OnClick="Search_Click" CssClass="btn btn-primary"/><asp:Button ID="btnAccountsCsv" runat="server" Text="Export accounts CSV" OnClick="AccountsCsv_Click" CssClass="btn btn-secondary"/></div>
<p class="sysadmin-caption">Staff and customer IDs belong to separate account types. Customer email is the customer login. Up to 1,000 matching accounts are shown.</p>
<div class="dashboard-table-wrapper"><asp:GridView ID="gvAccounts" runat="server" CssClass="dashboard-table" AutoGenerateColumns="false" AllowPaging="true" PageSize="25" OnPageIndexChanging="Accounts_Page" OnRowCommand="Account_Command" EmptyDataText="No accounts match."><Columns><asp:BoundField DataField="AccountType" HeaderText="Type"/><asp:BoundField DataField="AccountID" HeaderText="ID"/><asp:BoundField DataField="FullName" HeaderText="Name"/><asp:BoundField DataField="Username" HeaderText="Login"/><asp:BoundField DataField="EmailAddress" HeaderText="Email"/><asp:BoundField DataField="RoleName" HeaderText="Role"/><asp:BoundField DataField="AccountStatus" HeaderText="Status"/><asp:CheckBoxField DataField="IsBlocked" HeaderText="Blocked"/><asp:TemplateField HeaderText="Action"><ItemTemplate><asp:LinkButton ID="select" runat="server" Text="Manage" CommandName="ManageAccount" data-record-select="details" CommandArgument='<%# Eval("AccountType") + ":" + Eval("AccountID") %>' CausesValidation="false" CssClass="btn btn-secondary"/></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div>
</div><asp:Panel data-tab-pane="details" data-ready-id="pnlAccount" data-ready-kind="exists" ID="pnlAccount" runat="server" Visible="false" CssClass="sysadmin-card"><h2>Selected account</h2><asp:Label ID="lblSelected" runat="server" CssClass="sysadmin-caption"/><div class="sysadmin-form-grid"><div><label for="<%= txtUsername.ClientID %>">Staff username</label><asp:TextBox ID="txtUsername" runat="server" CssClass="form-control" MaxLength="50" autocomplete="off"/></div><div><label for="<%= txtEmail.ClientID %>">Email address</label><asp:TextBox ID="txtEmail" runat="server" CssClass="form-control" MaxLength="100" TextMode="Email"/></div><div><label for="<%= ddlRole.ClientID %>">Staff role</label><asp:DropDownList ID="ddlRole" runat="server" CssClass="form-select"><asp:ListItem>Administrator</asp:ListItem><asp:ListItem>Manager</asp:ListItem><asp:ListItem>Technician</asp:ListItem><asp:ListItem>SysAdmin</asp:ListItem></asp:DropDownList></div><div><label for="<%= txtPassword.ClientID %>">New password, leave blank to retain</label><asp:TextBox ID="txtPassword" runat="server" TextMode="Password" CssClass="form-control" MaxLength="128" autocomplete="new-password"/></div><div><label for="<%= txtConfirm.ClientID %>">Confirm new password</label><asp:TextBox ID="txtConfirm" runat="server" TextMode="Password" CssClass="form-control" MaxLength="128" autocomplete="new-password"/></div></div><p class="sysadmin-caption">Saving credentials revokes this account's tracked sessions and clears its reset codes. A password reset requires 8 to 128 characters, uppercase, lowercase, a number and a special character.</p><asp:Button ID="btnSave" runat="server" Text="Save credentials and revoke sessions" OnClick="Save_Click" CssClass="btn btn-primary"/>
<div class="sysadmin-security"><h3>Block or unblock access</h3><p>Blocking is separate from staff employment status and customer account status.</p><label for="<%= txtReason.ClientID %>">Reason, required for either action</label><asp:TextBox ID="txtReason" runat="server" CssClass="form-control" MaxLength="300"/><div class="sysadmin-buttons"><asp:Button ID="btnBlock" runat="server" Text="Block account" OnClick="Block_Click" CssClass="btn btn-secondary"/><asp:Button ID="btnUnblock" runat="server" Text="Unblock account" OnClick="Unblock_Click" CssClass="btn btn-secondary"/></div></div></asp:Panel></div></section>
<section data-ui-pane="create" class="sysadmin-pane"><div class="sysadmin-card"><h2>Register a staff user</h2><p>Creates an active staff account. Customer registration is available below.</p><div class="sysadmin-form-grid"><div><label for="<%= txtNewName.ClientID %>">Full name</label><asp:TextBox ID="txtNewName" runat="server" CssClass="form-control" MaxLength="100"/></div><div><label for="<%= txtNewPhone.ClientID %>">Local phone number, 10 digits</label><asp:TextBox ID="txtNewPhone" runat="server" CssClass="form-control" MaxLength="10"/></div><div><label for="<%= txtNewEmail.ClientID %>">Email</label><asp:TextBox ID="txtNewEmail" runat="server" CssClass="form-control" TextMode="Email" MaxLength="100"/></div><div><label for="<%= txtNewUsername.ClientID %>">Username</label><asp:TextBox ID="txtNewUsername" runat="server" CssClass="form-control" MaxLength="50" autocomplete="off"/></div><div><label for="<%= ddlNewRole.ClientID %>">Role</label><asp:DropDownList ID="ddlNewRole" runat="server" CssClass="form-select"><asp:ListItem>Technician</asp:ListItem><asp:ListItem>Administrator</asp:ListItem><asp:ListItem>Manager</asp:ListItem><asp:ListItem>SysAdmin</asp:ListItem></asp:DropDownList></div><div><label for="<%= txtSalary.ClientID %>">Salary, R. Use a full stop for cents</label><asp:TextBox ID="txtSalary" runat="server" CssClass="form-control" Text="0" inputmode="decimal"/></div><div><label for="<%= txtNewPassword.ClientID %>">Initial password</label><asp:TextBox ID="txtNewPassword" runat="server" TextMode="Password" CssClass="form-control" MaxLength="128" autocomplete="new-password"/></div><div><label for="<%= txtNewConfirm.ClientID %>">Confirm initial password</label><asp:TextBox ID="txtNewConfirm" runat="server" TextMode="Password" CssClass="form-control" MaxLength="128" autocomplete="new-password"/></div></div><asp:Button ID="btnCreate" runat="server" Text="Register staff user" OnClick="Create_Click" CssClass="btn btn-primary"/><p class="sysadmin-caption">No plaintext password is stored or included in the audit trail.</p></div>
<div class="sysadmin-card"><h2>Register a customer</h2><p>Use the customer registration form for SA IDs, passports and businesses.</p><a class="btn btn-secondary" href="<%= ResolveUrl("~/Account/Register.aspx?from=sysadmin") %>">Open customer registration</a></div></section>
<section data-ui-pane="sessions" class="sysadmin-pane"><div class="sysadmin-card"><h2>Authenticated sessions</h2><p>Observed client IP, browser description and activity. An IP address does not uniquely identify a physical device. Tracking begins after deployment; historical devices are unavailable.</p><asp:Button ID="btnSessions" runat="server" Text="Refresh sessions" OnClick="Sessions_Click" CssClass="btn btn-secondary"/><asp:CheckBox ID="cbActive" runat="server" Text=" Active sessions only" Checked="true"/></div><div class="dashboard-table-wrapper"><asp:GridView ID="gvSessions" runat="server" CssClass="dashboard-table" AutoGenerateColumns="false" AllowPaging="true" PageSize="25" OnPageIndexChanging="Sessions_Page" OnRowCommand="Session_Command" EmptyDataText="No matching tracked sessions."><Columns><asp:BoundField DataField="AccountType" HeaderText="Type"/><asp:BoundField DataField="AccountID" HeaderText="Account"/><asp:BoundField DataField="FullName" HeaderText="Name"/><asp:BoundField DataField="IPAddress" HeaderText="IP address"/><asp:BoundField DataField="UserAgent" HeaderText="Client description"/><asp:BoundField DataField="ClientApplication" HeaderText="Application"/><asp:BoundField DataField="LoggedInAtUtc" HeaderText="Signed in, UTC" DataFormatString="{0:yyyy-MM-dd HH:mm}"/><asp:BoundField DataField="LastSeenAtUtc" HeaderText="Last active, UTC" DataFormatString="{0:yyyy-MM-dd HH:mm}"/><asp:BoundField DataField="SessionStatus" HeaderText="Session status"/><asp:TemplateField HeaderText="Action"><ItemTemplate><asp:LinkButton ID="revoke" runat="server" Text="Revoke" CommandName="RevokeSession" CommandArgument='<%# Eval("SessionRecordID") %>' CausesValidation="false" CssClass="btn btn-secondary"/></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div></section>
<section data-ui-pane="reports" class="sysadmin-pane"><div class="sysadmin-card"><h2>Security reports</h2><p>UTC dates, up to 366 days. Reports return the latest 2,000 matching rows. Narrow the dates for larger datasets.</p><div class="sysadmin-toolbar"><div><label for="<%= ddlReport.ClientID %>">Report</label><asp:DropDownList ID="ddlReport" runat="server" CssClass="form-select"><asp:ListItem Value="Audit">Privileged changes</asp:ListItem><asp:ListItem Value="Sessions">Session access</asp:ListItem></asp:DropDownList></div><div><label for="<%= txtFrom.ClientID %>">From, UTC</label><asp:TextBox ID="txtFrom" runat="server" TextMode="Date" CssClass="form-control"/></div><div><label for="<%= txtTo.ClientID %>">Through, UTC</label><asp:TextBox ID="txtTo" runat="server" TextMode="Date" CssClass="form-control"/></div><asp:Button ID="btnReport" runat="server" Text="Generate report" OnClick="Report_Click" CssClass="btn btn-primary"/><asp:Button ID="btnCsv" runat="server" Text="Export report CSV" OnClick="Csv_Click" CssClass="btn btn-secondary"/></div></div><div class="dashboard-table-wrapper"><asp:GridView ID="gvReport" runat="server" CssClass="dashboard-table" AutoGenerateColumns="true" AllowPaging="true" PageSize="25" OnPageIndexChanging="Report_Page" EmptyDataText="Generate a report to view matching records."/></div></section>
<section data-ui-pane="settings" class="sysadmin-pane"><div class="sysadmin-card"><h2>Application configuration</h2><p>Only the settings below are editable here. Database connections and API credentials stay in the existing secure configuration.</p><div class="dashboard-table-wrapper"><asp:GridView ID="gvSettings" runat="server" CssClass="dashboard-table" AutoGenerateColumns="true"/></div><div class="sysadmin-toolbar"><div><label for="<%= ddlSetting.ClientID %>">Setting</label><asp:DropDownList ID="ddlSetting" runat="server" CssClass="form-select" AutoPostBack="true" OnSelectedIndexChanged="Setting_Changed"><asp:ListItem>CompanyDisplayName</asp:ListItem><asp:ListItem>SupportEmail</asp:ListItem><asp:ListItem>PublicRegistrationEnabled</asp:ListItem><asp:ListItem>SessionIdleMinutes</asp:ListItem></asp:DropDownList></div><div><label for="<%= txtSetting.ClientID %>">New value</label><asp:TextBox ID="txtSetting" runat="server" CssClass="form-control" MaxLength="500"/></div><asp:Button ID="btnSetting" runat="server" Text="Save setting" OnClick="Setting_Click" CssClass="btn btn-primary"/></div><p class="sysadmin-caption">Company name: up to 100 characters. Support email: blank or a valid email. Public registration: true or false. Session idle timeout: 5 to 60 minutes.</p></div></section>
</div></asp:Content>

<%@ Master Language="C#" AutoEventWireup="true"
CodeBehind="Dashboard.Master.cs"
Inherits="MajorProject.Web.MasterPages.Dashboard" %>

<%@ Register Src="~/Chatbot/Chatbot.ascx"
TagPrefix="tw"
TagName="Chatbot" %>

<!DOCTYPE html>

<html lang="en" data-theme="light">

<head runat="server">
    <script src="<%= ResolveUrl("~/Content/js/Site.js") %>?v=20261123"></script>


<meta charset="utf-8" />

<meta name="viewport"
      content="width=device-width, initial-scale=1.0" />

<meta name="theme-color"
      content="#07090d" />

<meta name="description"
      content="THY WILL Electrical & Construction Job & Resource Management System." />

<title>
    <%: Page.Title %> - THY WILL
</title>


<!-- ===================================================== -->
<!-- BOOTSTRAP                                             -->
<!-- ===================================================== -->

<link
    href="<%= ResolveUrl("~/Content/css/bootstrap.min.css") %>"
    rel="stylesheet" />


<!-- ===================================================== -->
<!-- BOOTSTRAP ICONS                                       -->
<!-- ===================================================== -->

<link
    href="<%= ResolveUrl("~/Content/vendor/bootstrap-icons/bootstrap-icons.css") %>?v=20261123"
    rel="stylesheet" />


<!-- ===================================================== -->
<!-- INTER                                                 -->
<!-- ===================================================== -->

<link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet" />


<!-- ===================================================== -->
<!-- THY WILL GLOBAL THEME                                  -->
<!-- ===================================================== -->

<link
    href="<%= ResolveUrl("~/Content/css/Site.css") %>"
    rel="stylesheet" />


<!-- ===================================================== -->
<!-- SECURE NAVIGATION                                     -->
<!-- ===================================================== -->

<link
    href="<%= ResolveUrl("~/Content/css/navigation.css") %>"
    rel="stylesheet" />


<!-- ===================================================== -->
<!-- SECURE DASHBOARD / PAGE STYLES                        -->
<!-- ===================================================== -->

<link
    href="<%= ResolveUrl("~/Content/css/dashboard.css") %>?v=20261123"
    rel="stylesheet" />


<!-- ===================================================== -->
<!-- THY WILL CHATBOT                                      -->
<!-- Customer chatbot component styles                     -->
<!-- ===================================================== -->

<link
    href="<%= ResolveUrl("~/Chatbot/Chatbot.css") %>"
    rel="stylesheet" />


<!-- ===================================================== -->
<!-- PAGE-SPECIFIC HEAD CONTENT                             -->
<!-- ===================================================== -->

<asp:ContentPlaceHolder
    ID="HeadContent"
    runat="server" />


    <link href="<%= ResolveUrl("~/Content/css/theme.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Content/css/components.css") %>?v=20261123" rel="stylesheet" />
</head>

<body class="dashboard-body tw-workspace" data-staff-session="<%= MajorProject.Web.Helpers.WebSession.StaffID > 0 ? "true" : "false" %>">


<!-- ===================================================== -->
<!-- LIQUID GLASS BACKGROUND                               -->
<!-- ===================================================== -->

<div class="dashboard-background-grid" aria-hidden="true">

    <div class="dashboard-orb dashboard-orb-one"></div>

    <div class="dashboard-orb dashboard-orb-two"></div>

    <div class="dashboard-orb dashboard-orb-three"></div>

    <div class="dashboard-background-grid-lines"></div>

</div>


<!-- ===================================================== -->
<!-- ASP.NET SERVER FORM                                    -->
<!-- ===================================================== -->

<form id="dashboardForm"
      runat="server">

    <asp:ScriptManager
        ID="ScriptManager1"
        runat="server" />


    <!-- ================================================= -->
    <!-- CUSTOMER SIDEBAR                                  -->
    <!-- ================================================= -->

    <aside id="customerSidebar"
           runat="server"
           class="customer-sidebar">

        <div class="customer-sidebar-inner">


            <!-- ========================================= -->
            <!-- CUSTOMER BRAND                             -->
            <!-- ========================================= -->

            <div class="customer-brand">

                <a href="<%= ResolveUrl("~/Default.aspx") %>"
                   class="customer-brand-link"
                   aria-label="THY WILL Home">

                    <span class="customer-brand-mark">

                        <i class="bi bi-lightning-charge-fill"></i>

                    </span>

                    <span class="customer-brand-text">

                        <strong><%= Server.HtmlEncode(MajorProject.Web.Helpers.SecurityGateway.CompanyName) %></strong>

                        <small>
                            Customer Portal
                        </small>

                    </span>

                </a>

            </div>


            <!-- ========================================= -->
            <!-- MOBILE CLOSE                               -->
            <!-- ========================================= -->

            <button type="button"
                    id="customerSidebarClose"
                    class="customer-sidebar-close"
                    aria-label="Close navigation">

                <i class="bi bi-x-lg"></i>

            </button>


            <!-- ========================================= -->
            <!-- CUSTOMER NAVIGATION                        -->
            <!-- ========================================= -->

            <nav class="customer-navigation"
                 aria-label="Customer navigation">


                <div class="customer-nav-section-label">
                    OVERVIEW
                </div>


                <!-- Dashboard -->

                <a href="<%= ResolveUrl("~/Secure/Customer/Dashboard.aspx") %>"
                   class="customer-nav-link">

                    <span class="customer-nav-icon">
                        <i class="bi bi-grid-1x2-fill"></i>
                    </span>

                    <span>
                        Dashboard
                    </span>

                </a>


                <div class="customer-nav-section-label">SERVICES</div>
                <!-- Book Job -->

                <a href="<%= ResolveUrl("~/Secure/Customer/BookJob.aspx") %>"
                   class="customer-nav-link">

                    <span class="customer-nav-icon">
                        <i class="bi bi-calendar-plus-fill"></i>
                    </span>

                    <span>
                        Book Job
                    </span>

                </a>


                <a href="<%= ResolveUrl("~/Secure/Customer/CancellationFees.aspx") %>" class="customer-nav-link">Booking changes &amp; fees</a>
                <!-- My Jobs -->

                <a href="<%= ResolveUrl("~/Secure/Customer/MyJobs.aspx") %>"
                   class="customer-nav-link">

                    <span class="customer-nav-icon">
                        <i class="bi bi-briefcase-fill"></i>
                    </span>

                    <span>
                        My Jobs
                    </span>

                </a>


                <div class="customer-nav-section-label">FINANCIAL</div>
                <!-- Invoices -->

                <a href="<%= ResolveUrl("~/Secure/Customer/Invoices.aspx") %>"
                   class="customer-nav-link">

                    <span class="customer-nav-icon">
                        <i class="bi bi-receipt-cutoff"></i>
                    </span>

                    <span>
                        Invoices
                    </span>

                </a>


                <!-- ===================================== -->
                <!-- ACCOUNT                                -->
                <!-- ===================================== -->

                <div class="customer-nav-section-label">
                    ACCOUNT
                </div>


                <!-- Profile -->

                <a href="<%= ResolveUrl("~/Secure/Customer/Profile.aspx") %>"
                   class="customer-nav-link">

                    <span class="customer-nav-icon">
                        <i class="bi bi-person-circle"></i>
                    </span>

                    <span>
                        Profile
                    </span>

                </a>

            </nav>


            <!-- ========================================= -->
            <!-- CUSTOMER SIDEBAR BOTTOM                   -->
            <!-- ========================================= -->

            <div class="customer-sidebar-bottom">


                <div class="customer-system-status">

                    <span class="status-dot"></span>

                    <span>
                        Customer workspace
                    </span>

                </div>


                <a href="<%= ResolveUrl("~/Account/Logout.aspx") %>"
                   class="customer-logout">

                    <span class="customer-nav-icon">
                        <i class="bi bi-box-arrow-right"></i>
                    </span>

                    <span>
                        Sign Out
                    </span>

                </a>

            </div>

        </div>

    </aside>


    <!-- ================================================= -->
    <!-- CUSTOMER MOBILE OVERLAY                            -->
    <!-- ================================================= -->

    <div id="customerSidebarOverlay"
         runat="server"
         class="customer-sidebar-overlay">
    </div>


    <!-- ================================================= -->
    <!-- STAFF TOP NAVIGATION                               -->
    <!-- Admin / Manager / Technician                       -->
    <!-- ================================================= -->

    <header id="staffTopbar"
            runat="server"
            class="staff-topbar">

        <div class="staff-topbar-inner">


            <!-- ========================================= -->
            <!-- STAFF BRAND                               -->
            <!-- ========================================= -->

            <a href="<%= ResolveUrl("~/Default.aspx") %>"
               class="staff-brand"
               aria-label="THY WILL Home">

                <span class="staff-brand-mark">

                    <i class="bi bi-lightning-charge-fill"></i>

                </span>

                <span class="staff-brand-text">

                    <strong><%= Server.HtmlEncode(MajorProject.Web.Helpers.SecurityGateway.CompanyName) %></strong>

                    <small>
                        Job &amp; Resource Management
                    </small>

                </span>

            </a>


            <!-- ========================================= -->
            <!-- MOBILE NAVIGATION BUTTON                   -->
            <!-- ========================================= -->

            <button type="button"
                    id="staffNavToggle"
                    class="staff-nav-toggle"
                    aria-label="Open navigation"
                    aria-expanded="false">

                <i class="bi bi-list"></i>

            </button>


            <!-- ========================================= -->
            <!-- STAFF NAVIGATION                           -->
            <!-- ========================================= -->

            <nav id="staffNavigation"
                 class="staff-navigation"
                 aria-label="Staff navigation">


                <!-- ===================================== -->
                <!-- DASHBOARD                              -->
                <!-- ===================================== -->

                <a href="<%= StaffDashboardUrl %>"
                   class="staff-nav-link">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- ===================================== -->
                <!-- ADMIN                                  -->
                <!-- ===================================== -->

                <asp:Panel
                    ID="AdminTopNavigation"
                    runat="server"
                    CssClass="staff-role-navigation"
                    Visible="false">


                    <a href="<%= ResolveUrl("~/Secure/Admin/Customers.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-people-fill"></i>

                        <span>
                            Customers
                        </span>

                    </a>


                    <a href="<%= ResolveUrl("~/Secure/Admin/WorkOrders.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-plus-circle-fill"></i>

                        <span>
                            New Job
                        </span>

                    </a>


                    <a href="<%= ResolveUrl("~/Secure/JobChanges.aspx") %>" class="staff-nav-link">Job changes</a>
                    <a href="<%= ResolveUrl("~/Secure/Admin/Jobs.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-briefcase-fill"></i>

                        <span>
                            Jobs
                        </span>

                    </a>


                    <a href="<%= ResolveUrl("~/Secure/Admin/Inventory.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-box-seam-fill"></i>

                        <span>
                            Inventory
                        </span>

                    </a>


                    <a href="<%= ResolveUrl("~/Secure/Admin/Profile.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-person-circle"></i>

                        <span>
                            Profile
                        </span>

                    </a>

                </asp:Panel>


                <!-- ===================================== -->
                <!-- MANAGER                                -->
                <!-- ===================================== -->

                <asp:Panel
                    ID="ManagerTopNavigation"
                    runat="server"
                    CssClass="staff-role-navigation"
                    Visible="false">


                    <a href="<%= ResolveUrl("~/Secure/Manager/Customers.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-people-fill"></i>

                        <span>
                            Customers
                        </span>

                    </a>


                    <a href="<%= ResolveUrl("~/Secure/Manager/WorkOrders.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-plus-circle-fill"></i>

                        <span>
                            New Job
                        </span>

                    </a>


                    <a href="<%= ResolveUrl("~/Secure/JobChanges.aspx") %>" class="staff-nav-link">Requests &amp; handovers</a><a href="<%= ResolveUrl("~/Secure/Manager/Jobs.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-briefcase-fill"></i>

                        <span>
                            Jobs
                        </span>

                    </a>


                    <a href="<%= ResolveUrl("~/Secure/Manager/Inventory.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-boxes"></i>

                        <span>
                            Inventory
                        </span>

                    </a>


                    <!-- ===================================== -->
                    <!-- SERVICES                              -->
                    <!-- ===================================== -->

                    <a href="<%= ResolveUrl("~/Secure/Manager/Services.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-tools"></i>

                        <span>
                            Services
                        </span>

                    </a>


                    <a href="<%= ResolveUrl("~/Secure/Manager/Reports.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-bar-chart-fill"></i>

                        <span>
                            Reports
                        </span>

                    </a>


                    <a href="<%= ResolveUrl("~/Secure/Manager/StaffManagement.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-person-badge-fill"></i>

                        <span>
                            Staff Management
                        </span>

                    </a>


                    <a href="<%= ResolveUrl("~/Secure/Manager/Profile.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-person-circle"></i>

                        <span>
                            Profile
                        </span>

                    </a>

                </asp:Panel>


                <!-- ===================================== -->
                <!-- TECHNICIAN                             -->
                <!-- ===================================== -->

                <asp:Panel
                    ID="TechnicianTopNavigation"
                    runat="server"
                    CssClass="staff-role-navigation"
                    Visible="false">


                    <a href="<%= ResolveUrl("~/Secure/JobChanges.aspx") %>" class="staff-nav-link">Allocations &amp; materials <span id="allocation-count" role="status" aria-live="polite"></span></a><a href="<%= ResolveUrl("~/Secure/Technician/Jobs.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-tools"></i>

                        <span>
                            My Jobs
                        </span>

                    </a>


                    <a href="<%= ResolveUrl("~/Secure/Technician/Inventory.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-box-seam-fill"></i>

                        <span>
                            Inventory
                        </span>

                    </a>


                    <a href="<%= ResolveUrl("~/Secure/Technician/Profile.aspx") %>"
                       class="staff-nav-link">

                        <i class="bi bi-person-circle"></i>

                        <span>
                            Profile
                        </span>

                    </a>

                </asp:Panel>

            <a class="staff-nav-link staff-mobile-logout" href="<%= ResolveUrl("~/Account/Logout.aspx") %>"><i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>Sign Out</span></a>
            </nav>


            <!-- ========================================= -->
            <!-- STAFF USER AREA                            -->
            <!-- ========================================= -->

            <div class="staff-user-area">
<button type="button" class="tw-theme-toggle" data-theme-toggle aria-label="Switch colour theme" aria-pressed="false" title="Switch colour theme"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"/></svg><span class="tw-theme-label">Theme</span></button>


                <div class="staff-user">

                    <div class="staff-user-avatar">

                        <asp:Literal
                            ID="StaffUserInitials"
                            runat="server" />

                    </div>


                    <div class="staff-user-details">

                        <span class="staff-user-name">

                            <asp:Literal
                                ID="StaffUserFullName"
                                runat="server" />

                        </span>

                        <span class="staff-user-role">

                            <asp:Literal
                                ID="StaffUserRole"
                                runat="server" />

                        </span>

                    </div>

                </div>


                <a href="<%= ResolveUrl("~/Account/Logout.aspx") %>"
                   class="staff-logout"
                   title="Sign out"
                   aria-label="Sign out">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </div>

        </div>

    </header>


    <!-- ================================================= -->
    <!-- MAIN APPLICATION CONTENT                           -->
    <!-- ================================================= -->

    <main id="dashboardMain"
          runat="server"
          class="dashboard-main">


        <div class="tw-portal-toolbar"><span class="tw-workspace-label">THY WILL <span>/ Customer workspace</span></span><button type="button" class="tw-theme-toggle" data-theme-toggle aria-label="Switch colour theme" aria-pressed="false" title="Switch colour theme"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"/></svg><span class="tw-theme-label">Theme</span></button></div>
        <section class="dashboard-content" id="main-content" data-workspace-content>

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server" />

        </section>


        <!-- ============================================= -->
        <!-- FOOTER                                         -->
        <!-- ============================================= -->

        <footer class="dashboard-footer">

            <span>
                &copy; <%: DateTime.Now.Year %>
                THY WILL Electrical &amp; Construction (Pty) Ltd.
            </span>

            <span>
                Job &amp; Resource Management System
            </span>

            <a href="<%= ResolveUrl("~/Public/PrivacyPolicy.aspx#legal-07") %>">Privacy preferences</a>
        </footer>

    </main>


    <!-- ================================================= -->
    <!-- CUSTOMER CHATBOT                                  -->
    <!-- ================================================= -->

    <asp:PlaceHolder
        ID="CustomerChatbotContainer"
        runat="server"
        Visible="false">

        <tw:Chatbot
            ID="CustomerChatbot"
            runat="server" />

    </asp:PlaceHolder>

</form>


<!-- ===================================================== -->
<!-- BOOTSTRAP JAVASCRIPT                                  -->
<!-- ===================================================== -->

<script
    src="<%= ResolveUrl("~/Scripts/bootstrap.bundle.min.js") %>">
</script>


<!-- ===================================================== -->
<!-- THY WILL JAVASCRIPT                                   -->
<!-- ===================================================== -->




<% if (MajorProject.Web.Helpers.WebSession.HasRole("Technician")) { %>
<script>(function(){var busy=false,stopped=false;async function check(){if(busy||stopped||document.hidden)return;busy=true;var badge=document.getElementById('allocation-count');try{var r=await fetch('<%= ResolveUrl("~/Secure/Technician/AllocationCount.ashx") %>',{credentials:'same-origin',cache:'no-store'});if(r.redirected||r.status===403){stopped=true;badge.textContent='Session ended';return;}if(!r.ok)throw new Error();var d=await r.json();badge.textContent=d.count?'('+d.count+' unread)':'';}catch(_){badge.textContent='Notifications unavailable';}finally{busy=false;}}check();setInterval(check,30000);})();</script>
<% } %>
</body>

</html>

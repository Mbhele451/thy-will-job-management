<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SystemAdmin.Master.cs" Inherits="MajorProject.Web.MasterPages.SystemAdmin" %>
<!DOCTYPE html><html lang="en" data-theme="dark"><head runat="server"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>THY WILL | System administration</title><script src="<%= ResolveUrl("~/Content/js/Site.js") %>?v=20261123"></script><link href="<%= ResolveUrl("~/Content/css/bootstrap.min.css") %>" rel="stylesheet"/><link href="<%= ResolveUrl("~/Content/vendor/bootstrap-icons/bootstrap-icons.css") %>?v=20261123" rel="stylesheet"/><link href="<%= ResolveUrl("~/Content/css/theme.css") %>" rel="stylesheet"/><link href="<%= ResolveUrl("~/Content/css/components.css") %>?v=20261123" rel="stylesheet"/><link href="<%= ResolveUrl("~/Content/css/sysadmin.css") %>" rel="stylesheet"/><asp:ContentPlaceHolder ID="HeadContent" runat="server"/></head><body class="tw-workspace sysadmin-body" data-staff-session="true"><form id="form1" runat="server" novalidate="novalidate"><asp:ScriptManager ID="sm" runat="server"/><header class="sysadmin-header"><a href="<%= ResolveUrl("~/Secure/SysAdmin/Dashboard.aspx") %>" class="sysadmin-brand"><strong><%= Server.HtmlEncode(CompanyName) %></strong><small>System administration</small></a><div class="sysadmin-actions"><span><%= Server.HtmlEncode(MajorProject.Web.Helpers.WebSession.FullName) %></span><button type="button" class="tw-theme-toggle" data-theme-toggle="true" aria-label="Switch theme">Theme</button><a href="<%= ResolveUrl("~/Account/Logout.aspx") %>">Sign out</a></div></header><main class="sysadmin-main"><asp:ContentPlaceHolder ID="MainContent" runat="server"/></main><footer class="sysadmin-footer">Security console. Times shown in UTC. <%= Server.HtmlEncode(SupportEmail) %></footer></form></body></html>

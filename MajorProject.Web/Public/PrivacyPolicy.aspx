<%@ Page Title="Privacy Policy" Language="C#" MasterPageFile="~/MasterPages/Public.Master" AutoEventWireup="true" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<section class="pr-page-hero hp-wrap"><div class="pr-heading" data-reveal><p class="hp-kicker">Privacy & information</p><h1>Privacy Policy</h1><p class="pr-lead">Information about your relationship with THY WILL Electrical &amp; Construction.</p></div><figure class="pr-hero-picture" data-reveal><img src="<%= ResolveUrl("~/Content/images/editorial/wiring.jpg") %>" alt="Electrical services and installation" loading="eager" width="1200" height="900" /></figure></section><section class="hp-wrap pr-legal-layout hp-section"><nav class="pr-legal-toc" aria-label="On this page"><p class="hp-kicker">On this page</p><a href="#legal-01"><span>01</span>Introduction and Scope</a><a href="#legal-02"><span>02</span>Information We Collect</a><a href="#legal-03"><span>03</span>Purpose of Data Processing</a><a href="#legal-04"><span>04</span>POPIA Compliance</a><a href="#legal-05"><span>05</span>Data Sharing and Disclosure</a><a href="#legal-06"><span>06</span>Data Security Safeguards</a><a href="#legal-07"><span>07</span>Cookies and Session Management</a><a href="#legal-08"><span>08</span>Information Officer Contact</a></nav><div class="pr-legal-copy"><section id="legal-01" class="pr-legal-section" data-reveal><span class="hp-kicker">Section 01</span><h2>Introduction and Scope</h2><p class="lh-base mb-0">
                                    THY WILL Electrical &amp; Construction ("we," "our," or "us"),
                                    based in Durban, KwaZulu-Natal, operates this web application.
                                    This Privacy Policy applies to all visitors, prospective
                                    clients, and users interacting with our online portal,
                                    project management tools, and service booking channels.
                                </p></section><section id="legal-02" class="pr-legal-section" data-reveal><span class="hp-kicker">Section 02</span><h2>Information We Collect</h2><p class="lh-base">
                                    We collect personal details that you voluntarily provide
                                    through our registration forms, service request panels,
                                    and client portal, including:
                                </p><ul class="tw-legal-list mb-3">
                                    <li>Full Name and Contact Person details</li>
                                    <li>Email Address and Telephone / Mobile numbers</li>
                                    <li>Physical installation / site addresses (Street address, Area, City, Province)</li>
                                    <li>Customer classification (Residential or Commercial)</li>
                                </ul><p class="lh-base mb-0">
                                            Additionally, our web servers automatically log technical
                                            metadata such as your IP address, browser type, device
                                            descriptors, and session timestamps to facilitate secure
                                            login sessions.
                                        </p></section><section id="legal-03" class="pr-legal-section" data-reveal><span class="hp-kicker">Section 03</span><h2>Purpose of Data Processing</h2><p class="lh-base">
                                    The information we gather is processed strictly to:
                                </p><ul class="tw-legal-list mb-0">
                                    <li>
                                        Process electrical and construction service bookings
                                        and site inspections
                                    </li>

                                    <li>
                                        Supply accurate project cost estimates, quotes,
                                        and tax invoices
                                    </li>

                                    <li>
                                        Manage user authentication and administrative
                                        role access
                                    </li>

                                    <li>
                                        Provide password reset security via One-Time
                                        Passwords (OTP)
                                    </li>

                                    <li>
                                        Ensure site safety and maintain audit compliance
                                    </li>
                                </ul></section><section id="legal-04" class="pr-legal-section" data-reveal><span class="hp-kicker">Section 04</span><h2>POPIA Compliance</h2><p class="lh-base">
                                    As a registered South African entity operating under the
                                    <strong class="tw-text-primary">
                                        Protection of Personal Information Act
                                        (Act 4 of 2013 - POPIA)
                                    </strong>,
                                    we uphold your statutory rights as a data subject.
                                    You maintain the right to:
                                </p><ul class="tw-legal-list mb-0">
                                    <li>
                                        Request confirmation of whether we hold personal
                                        information about you
                                    </li>

                                    <li>
                                        Request access to or copies of your recorded
                                        personal data
                                    </li>

                                    <li>
                                        Request correction, destruction, or deletion
                                        of personal information
                                    </li>

                                    <li>
                                        Object to the processing of personal data on
                                        reasonable grounds
                                    </li>
                                </ul></section><section id="legal-05" class="pr-legal-section" data-reveal><span class="hp-kicker">Section 05</span><h2>Data Sharing and Disclosure</h2><p class="lh-base mb-0">
                                    We do not sell, lease, or trade personal customer information
                                    to any commercial third parties. Personal data is only shared
                                    with trusted service providers (e.g., secure database hosting
                                    providers, SMS/Email OTP processing gateways) required to
                                    fulfill our operational services.
                                </p></section><section id="legal-06" class="pr-legal-section" data-reveal><span class="hp-kicker">Section 06</span><h2>Data Security Safeguards</h2><p class="lh-base mb-0">
                                    The application uses salted password hashes, role checks and
                                    session validation. Production deployment requires HTTPS,
                                    restricted database access, approved retention periods and
                                    operational security procedures. Local demonstration builds
                                    are not evidence that all production safeguards are configured.
                                </p></section><section id="legal-07" class="pr-legal-section" data-reveal><span class="hp-kicker">Section 07</span><h2>Cookies and Session Management</h2><p class="lh-base mb-0">
                                    Our web application uses essential session cookies to
                                    maintain user authentication status across page requests.
                                    A theme preference and your privacy choice may be stored locally.
                                    Optional demo analytics are off until you choose to allow them.
                                    They count page views and navigation clicks in memory in the current tab only;
                                    these counts are not transmitted or retained after navigation. No form values,
                                    passwords, heatmaps or session recordings are collected by this feature.
                                    Use the preferences below to change your choice and clear the current counters.
                                    Security session records separately include account identifiers, IP address,
                                    client information and session timestamps for access control and auditing.
                                </p>
                    <div data-privacy-preferences class="privacy-preferences">
                        <button type="button" data-choice="essential">Essential only</button>
                        <button type="button" data-choice="analytics">Allow demo analytics</button>
                        <p role="status" aria-live="polite"></p>
                    </div>
                </section><section id="legal-08" class="pr-legal-section" data-reveal><span class="hp-kicker">Section 08</span><h2>Information Officer Contact</h2><p class="lh-base">
                                    For any questions regarding this Privacy Policy or to
                                    exercise your rights under POPIA, please contact our
                                    designated Information Officer:
                                </p></section></div></section><section class="pr-cta hp-wrap" data-reveal><p class="hp-kicker">Start a conversation</p><div><h2>Tell us about<br /><span>your next project.</span></h2><a class="hp-button" href="~/Public/Contact.aspx" runat="server">Discuss your project <span aria-hidden="true">&#8599;</span></a></div></section>
</asp:Content>
